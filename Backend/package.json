{
  "name": "calorie-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Calorie Tracker Pro",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "stop": "powershell -ExecutionPolicy Bypass -File ./kill-port.ps1",
    "seed": "node scripts/seed-products.js",
    "add-admin": "node scripts/add-admin.js",
    "check-deploy": "node scripts/check-deploy.js",
    "docker:add-admin": "docker compose -f ../docker-compose.yml exec backend node scripts/add-admin.js",
    "docker:up": "docker compose -f ../docker-compose.yml up --build -d",
    "docker:down": "docker compose -f ../docker-compose.yml down",
    "docker:logs": "docker compose -f ../docker-compose.yml logs -f backend"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0",
    "pg": "^8.12.0",
    "pg-connection-string": "^2.11.0"
  }
}
