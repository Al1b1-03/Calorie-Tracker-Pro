PORT=3003
NODE_ENV=development

# PostgreSQL
# Локально (npm run dev) + Postgres в Docker: localhost:5433
# Полный стек в Docker: DATABASE_URL задаётся в docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/calorie_tracker

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# AI Camera — food recognition
# auto: OpenAI → Gemini → local CLIP (works without API keys)
VISION_PROVIDER=auto

# OpenAI Vision (optional, best accuracy)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Google Gemini Vision (optional)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# Local CLIP model (used automatically when no API keys)
VISION_LOCAL_MODEL=Xenova/clip-vit-base-patch32
