PORT=3003
NODE_ENV=development

# --- Режим 1: общая база с Render (Docker + прод = одни данные) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME
# DATABASE_SSL=true
# JWT_SECRET=тот же секрет, что на Render

# --- Режим 2: только локально ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/calorie_tracker
# DATABASE_SSL=false
# docker compose --profile local-db up -d --build

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/calorie_tracker
DATABASE_SSL=false

JWT_SECRET=your-super-secret-key-change-in-production

VISION_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
VISION_LOCAL_MODEL=Xenova/clip-vit-base-patch16
